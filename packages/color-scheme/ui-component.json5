{
  id: "color-scheme",
  name: "Color scheme",
  version: "0.2.0",
  type: "ui-chassis-component",
  description: "Unstyled light/dark mechanism: no-FOUC head hook, saved choice, system preference, toggle behavior and a11y. No colors; palettes are paint, toggle placement is the body kit.",
  layer: "chassis",
  slots: {
    head: {
      stylesheets: ["css/color-scheme.css"],
      inlineScripts: ["js/color-scheme-head.js"],
      after: ["css/site.css"],
    },
    footer: {
      scripts: ["js/color-scheme.js"],
      after: ["js/ui-bus.js"],
    },
  },
}
