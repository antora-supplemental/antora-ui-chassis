  "exports": {
    ".": "./lib/index.js",
    "./lib": "./lib/index.js",
    "./js/color-scheme.js": "./js/color-scheme.js",
    "./js/color-scheme-paint-head.js": "./js/color-scheme-paint-head.js",
    "./js/color-scheme-schemes-head.js": "./js/color-scheme-schemes-head.js",
    "./js/color-scheme-picker.js": "./js/color-scheme-picker.js",
    "./css/color-scheme.css": "./css/color-scheme.css",
    "./css/color-scheme-picker.css": "./css/color-scheme-picker.css"
  },
  "files": [
    "lib",
    "js",
    "css",
    "scripts",
    "test",
    "ui-component.json5",
    "README.adoc",
    "CHANGELOG.adoc"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
