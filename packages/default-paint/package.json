{
  "name": "@antora-supplemental/default-paint",
  "version": "0.2.1",
  "antoraRegistry": {
    "title": "Default Paint",
    "antora": "3",
    "requires": {
      "@antora-supplemental/color-scheme": "^0.5.0"
    },
    "uses": {
      "default-ui-markup": "2"
    },
    "provides": {
      "default-ui-paint-tokens": "0.2"
    }
  },
  "description": "PAINT layer: light and dark palette for the Antora Default UI on the chassis --cs-* contract. Colors only; pair with @antora-supplemental/light-dark-mode for switching.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib": "./lib/index.js",
    "./css/default-paint.css": "./css/default-paint.css"
  },
  "files": ["lib", "css", "test", "ui-component.json5", "README.adoc", "CHANGELOG.adoc"],
  "scripts": { "test": "node --test test/*.test.js" },
  "keywords": ["antora", "antora-ui", "antora-extension", "paint", "palette", "dark-mode", "color-scheme", "antora-ui-default"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antora-supplemental/antora-ui-chassis.git",
    "directory": "packages/default-paint"
  }
}
