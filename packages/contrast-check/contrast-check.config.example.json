{
  "thresholds": { "text": 4.5, "large": 3, "nonText": 3, "link": 3 },
  "nearMargin": 0.5,
  "similarState": 1.2,
  "apca": false,
  "pages": ["index.html", "**/*.html"],
  "maxPages": 20,
  "schemes": [],
  "failOn": "error",
  "ignore": {
    "selectors": ["#search-input"],
    "rules": ["hover-unchanged"],
    "pages": ["_/**"]
  },
  "maxAnnotations": 50,
  "failOnStale": false,
  "suppress": [
    { "rule": "color-contrast", "selector": ".search-input::placeholder", "scheme": ["dark"], "reason": "Placeholder text, not content; tracked in #42", "expires": "2027-03-31" },
    { "rule": "hover-no-change", "page": "api/**/*.html", "reason": "Generated API nav uses focus styles only" },
    { "rule": "link-distinguishable", "selector": ".toc a", "colors": { "fg": "#1565c0", "bg": "#ffffff" }, "reason": "TOC links are a list, not inline text" }
  ]
}
