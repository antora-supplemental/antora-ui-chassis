{{!-- @antora-supplemental/brand-placeholder: placeholder logo, replace with your own.
  Inline so it inherits the text color (currentColor) in light and dark paint.
  Parameters: base (BEM block class, default "brand-logo"; renders "<base> <base>--placeholder"), size (default 30).
  Do not override in a theme bundle; sites replace the logo with site.keys.header_logo. --}}
<svg class="{{#if base}}{{base}} {{base}}--placeholder{{else}}brand-logo brand-logo--placeholder{{/if}}" viewBox="0 0 48 48" width="{{#if size}}{{size}}{{else}}30{{/if}}" height="{{#if size}}{{size}}{{else}}30{{/if}}" aria-hidden="true" focusable="false">
  <title>Placeholder logo - replace with your own</title>
  <g fill="currentColor">
    <path d="M24 2.5C30 8 30 15 24 20.5C18 15 18 8 24 2.5Z"/>
    <path d="M24 2.5C30 8 30 15 24 20.5C18 15 18 8 24 2.5Z" transform="rotate(60 24 24)"/>
    <path d="M24 2.5C30 8 30 15 24 20.5C18 15 18 8 24 2.5Z" transform="rotate(120 24 24)"/>
    <path d="M24 2.5C30 8 30 15 24 20.5C18 15 18 8 24 2.5Z" transform="rotate(180 24 24)"/>
    <path d="M24 2.5C30 8 30 15 24 20.5C18 15 18 8 24 2.5Z" transform="rotate(240 24 24)"/>
    <path d="M24 2.5C30 8 30 15 24 20.5C18 15 18 8 24 2.5Z" transform="rotate(300 24 24)"/>
  </g>
</svg>
